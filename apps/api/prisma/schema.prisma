generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  displayName  String?   @map("display_name")
  locale       String    @default("pt-BR")
  timezone     String    @default("America/Sao_Paulo")
  platformRole String?   @map("platform_role") @db.VarChar(32)
  suspendedAt  DateTime? @map("suspended_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  identities              Identity[]
  ownedOrganizations      Organization[]         @relation("OrganizationOwner")
  organizationMembers     OrganizationMember[]
  passwordCredential      PasswordCredential?
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         OrganizationInvitation[] @relation("InvitedBy")
  mediaUploads            MediaUpload[]            @relation("UploadedMedia")

  @@index([deletedAt])
  @@map("users")
}

model Identity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  emailVerified  Boolean  @default(false) @map("email_verified")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model Organization {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique
  name        String
  status      String    @default("ACTIVE")
  ownerId     String    @map("owner_id") @db.Uuid
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  owner            User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members          OrganizationMember[]
  invitations      OrganizationInvitation[]
  events           Event[]
  venues           Venue[]
  ticketTypes      TicketType[]
  ticketInventories TicketInventory[]
  reservations     Reservation[]
  orders           Order[]
  paymentAttempts  PaymentAttempt[]
  tickets          Ticket[]
  ticketCredentials TicketCredential[]
  checkIns         CheckIn[]
  ticketTransfers  TicketTransfer[]
  feePolicies       FeePolicy[]
  ledgerAccounts    LedgerAccount[]
  sellerBalance     SellerBalance?
  balanceSettlements BalanceSettlement[]
  payoutRecipient   PayoutRecipient?
  payouts           Payout[]
  mediaUploads      MediaUpload[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    @default("MEMBER")
  status         String    @default("INVITED")
  invitedAt      DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt       DateTime? @map("joined_at") @db.Timestamptz
  removedAt      DateTime? @map("removed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, role, status])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  inviterId      String    @map("inviter_id") @db.Uuid
  email          String    @db.VarChar(320)
  role           String    @db.VarChar(64)
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  usedAt         DateTime? @map("used_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  inviter      User         @relation("InvitedBy", fields: [inviterId], references: [id])

  @@index([organizationId, usedAt, revokedAt])
  @@map("organization_invitations")
}

model IdempotencyRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  type           String
  version        String    @default("1")
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([processedAt])
  @@index([organizationId])
  @@map("outbox_events")
}

model Venue {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(500)
  address        String
  city           String       @db.VarChar(255)
  state          String       @db.VarChar(255)
  country        String       @db.VarChar(2)
  postalCode     String?      @map("postal_code") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id])
  events         Event[]

  @@index([organizationId])
  @@map("venues")
}

model Event {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(500)
  description    String?
  status         String       @default("DRAFT") @db.VarChar(50)
  version        Int          @default(1)
  slug           String?      @db.VarChar(500)
  metadata       Json?
  format         String?      @db.VarChar(50)
  startsAt       DateTime?    @map("starts_at") @db.Timestamptz
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz
  timezone       String?      @db.VarChar(100)
  onlineInfo     String?      @map("online_info")
  venueId        String?      @map("venue_id") @db.Uuid
  currency       String?      @db.VarChar(3)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz
  coverImageKey  String?      @map("cover_image_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization      @relation(fields: [organizationId], references: [id])
  venue             Venue?            @relation(fields: [venueId], references: [id])
  ticketTypes       TicketType[]
  ticketInventories TicketInventory[]
  reservations      Reservation[]
  orders            Order[]
  tickets           Ticket[]
  checkIns          CheckIn[]

  @@index([organizationId])
  @@index([status])
  @@index([venueId])
  @@unique([slug])
  @@map("events")
}

model TicketType {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(500)
  description    String?
  priceAmount    Int               @map("price_amount")
  capacity       Int
  status         String            @default("ACTIVE") @db.VarChar(50)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  event           Event             @relation(fields: [eventId], references: [id])
  organization    Organization      @relation(fields: [organizationId], references: [id])
  ticketInventory TicketInventory?
  reservationItems ReservationItem[]
  orderItems       OrderItem[]
  tickets          Ticket[]

  @@index([eventId])
  @@index([organizationId])
  @@index([status])
  @@map("ticket_types")
}

model AuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_entries")
}

model TicketInventory {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketTypeId   String     @unique @map("ticket_type_id") @db.Uuid
  eventId        String     @map("event_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  capacity       Int
  reserved       Int        @default(0)
  committed      Int        @default(0)
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([eventId])
  @@index([organizationId])
  @@map("ticket_inventory")
}

model Reservation {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  eventId               String            @map("event_id") @db.Uuid
  status                String            @default("ACTIVE") @db.VarChar(20)
  continuationTokenHash String            @map("continuation_token_hash") @db.VarChar(64)
  idempotencyKey        String?           @unique @map("idempotency_key") @db.VarChar(255)
  expiresAt             DateTime          @map("expires_at") @db.Timestamptz
  currency              String            @db.VarChar(3)
  subtotalAmount        BigInt            @default(0) @map("subtotal_amount")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  event        Event              @relation(fields: [eventId], references: [id])
  items        ReservationItem[]
  order        Order?

  @@index([organizationId, eventId])
  @@index([expiresAt])
  @@index([status])
  @@map("reservations")
}

model ReservationItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId   String      @map("reservation_id") @db.Uuid
  ticketTypeId    String      @map("ticket_type_id") @db.Uuid
  quantity        Int
  nameSnapshot    String      @map("name_snapshot") @db.VarChar(500)
  unitPriceAmount BigInt      @map("unit_price_amount")
  currency        String      @db.VarChar(3)
  subtotalAmount  BigInt      @map("subtotal_amount")

  reservation Reservation @relation(fields: [reservationId], references: [id])
  ticketType  TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@index([reservationId])
  @@index([ticketTypeId])
  @@map("reservation_items")
}

model Order {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  eventId              String    @map("event_id") @db.Uuid
  reservationId        String    @unique @map("reservation_id") @db.Uuid
  status               String    @default("PENDING_PAYMENT") @db.VarChar(30)
  currency             String    @db.VarChar(3)
  subtotalAmount       BigInt    @map("subtotal_amount")
  totalAmount          BigInt    @map("total_amount")
  idempotencyKey       String?   @unique @map("idempotency_key") @db.VarChar(255)
  buyerEmail           String?   @map("buyer_email") @db.VarChar(255)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason   String?   @map("cancellation_reason") @db.VarChar(255)
  cancellationSource   String?   @map("cancellation_source") @db.VarChar(30)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  reservation  Reservation  @relation(fields: [reservationId], references: [id])
  items        OrderItem[]
  paymentAttempts PaymentAttempt[]
  tickets      Ticket[]
  pricingSnapshot   OrderPricingSnapshot?
  balanceSettlement BalanceSettlement?

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("orders")
}

model OrderItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String     @map("order_id") @db.Uuid
  ticketTypeId    String     @map("ticket_type_id") @db.Uuid
  nameSnapshot    String     @map("name_snapshot") @db.VarChar(500)
  unitPriceAmount BigInt     @map("unit_price_amount")
  quantity        Int
  subtotalAmount  BigInt     @map("subtotal_amount")

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model PaymentAttempt {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  provider           String    @db.VarChar(50)
  externalPaymentId  String?   @unique @map("external_payment_id") @db.VarChar(255)
  status             String    @default("PENDING") @db.VarChar(20)
  paymentMethod      String    @map("payment_method") @db.VarChar(50)
  amount             BigInt
  currency           String    @db.VarChar(3)
  idempotencyKey     String?   @unique @map("idempotency_key") @db.VarChar(255)
  failureCode        String?   @map("failure_code") @db.VarChar(100)
  checkoutData       Json?     @map("checkout_data")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization          @relation(fields: [organizationId], references: [id])
  order         Order                 @relation(fields: [orderId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String    @db.VarChar(50)
  providerEventId   String    @map("provider_event_id") @db.VarChar(255)
  paymentAttemptId  String?   @map("payment_attempt_id") @db.Uuid
  externalPaymentId String    @map("external_payment_id") @db.VarChar(255)
  eventType         String    @map("event_type") @db.VarChar(100)
  rawStatus         String    @map("raw_status") @db.VarChar(100)
  amount            BigInt?
  currency          String?   @db.VarChar(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  failedAt          DateTime? @map("failed_at") @db.Timestamptz
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@unique([provider, providerEventId])
  @@index([externalPaymentId])
  @@index([paymentAttemptId])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model Ticket {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  orderItemId    String   @map("order_item_id") @db.Uuid
  ticketTypeId   String   @map("ticket_type_id") @db.Uuid
  unitIndex      Int      @map("unit_index")
  publicCode     String   @unique @map("public_code") @db.VarChar(64)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz

  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  credentials     TicketCredential[]
  checkIns        CheckIn[]
  ticketTransfers TicketTransfer[]

  @@unique([orderItemId, unitIndex])
  @@index([orderId])
  @@index([organizationId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@map("tickets")
}

model TicketCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  status         String    @default("ACTIVE") @db.VarChar(20)
  version        Int       @default(1)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  ticket       Ticket       @relation(fields: [ticketId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  checkIns     CheckIn[]

  @@index([ticketId])
  @@index([organizationId])
  @@map("ticket_credentials")
}

model CheckIn {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  ticketId          String    @map("ticket_id") @db.Uuid
  credentialId      String    @map("credential_id") @db.Uuid
  performedByUserId String?   @map("performed_by_user_id") @db.Uuid
  result            String    @db.VarChar(30)
  idempotencyKey    String?   @unique @map("idempotency_key") @db.VarChar(100)
  checkedInAt       DateTime  @default(now()) @map("checked_in_at") @db.Timestamptz
  source            String    @default("SCANNER") @db.VarChar(20)
  notes             String?

  organization Organization     @relation(fields: [organizationId], references: [id])
  event        Event             @relation(fields: [eventId], references: [id])
  ticket       Ticket            @relation(fields: [ticketId], references: [id])
  credential   TicketCredential  @relation(fields: [credentialId], references: [id])

  @@index([eventId])
  @@index([ticketId])
  @@index([organizationId])
  @@map("check_ins")
}

model TicketTransfer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  claimTokenHash String    @map("claim_token_hash") @db.VarChar(64)
  status         String    @default("PENDING") @db.VarChar(20)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  ticket       Ticket       @relation(fields: [ticketId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([claimTokenHash])
  @@map("ticket_transfers")
}

model FeePolicy {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String?   @map("organization_id") @db.Uuid
  platformFeeBps      Int       @default(0) @map("platform_fee_bps")
  processingFeeBps    Int?      @map("processing_fee_bps")
  refundFeePolicy     String    @default("TBD") @map("refund_fee_policy")
  settlementDelayDays Int       @default(7) @map("settlement_delay_days")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization?         @relation(fields: [organizationId], references: [id])
  pricingSnapshots  OrderPricingSnapshot[]

  @@index([organizationId])
  @@map("fee_policies")
}

model OrderPricingSnapshot {
  orderId              String   @id @map("order_id") @db.Uuid
  feePolicyId          String   @map("fee_policy_id") @db.Uuid
  grossAmount          BigInt   @map("gross_amount")
  currency             String
  platformFeeBps       Int      @default(0) @map("platform_fee_bps")
  platformFeeAmount    BigInt   @default(0) @map("platform_fee_amount")
  processingFeeBps     Int?     @map("processing_fee_bps")
  processingFeeAmount  BigInt   @default(0) @map("processing_fee_amount")
  refundFeePolicy      String   @map("refund_fee_policy")
  sellerNetAmount      BigInt   @map("seller_net_amount")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  order     Order     @relation(fields: [orderId], references: [id])
  feePolicy FeePolicy @relation(fields: [feePolicyId], references: [id])

  @@index([feePolicyId])
  @@map("order_pricing_snapshots")
}

model LedgerAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique
  name           String
  accountType    String   @map("account_type")
  organizationId String?  @map("organization_id") @db.Uuid
  currency       String   @default("BRL")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization?  @relation(fields: [organizationId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([organizationId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id")
  description String?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  entries LedgerEntry[]

  @@unique([sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([occurredAt(sort: Desc)])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ledgerTransactionId  String   @map("ledger_transaction_id") @db.Uuid
  accountId            String   @map("account_id") @db.Uuid
  entryType            String   @map("entry_type")
  amount               BigInt
  currency             String
  description          String?
  occurredAt           DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  account           LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([ledgerTransactionId])
  @@index([accountId])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("ledger_entries")
}

model SellerBalance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @unique @map("organization_id") @db.Uuid
  pendingAmount   BigInt   @default(0) @map("pending_amount")
  availableAmount BigInt   @default(0) @map("available_amount")
  reservedAmount  BigInt   @default(0) @map("reserved_amount")
  currency        String   @default("BRL")
  version         Int      @default(0)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("seller_balances")
}

model BalanceSettlement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String   @unique @map("order_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sellerNetAmount BigInt   @map("seller_net_amount")
  currency        String
  settledAt       DateTime @default(now()) @map("settled_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  order        Order        @relation(fields: [orderId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([settledAt(sort: Desc)])
  @@map("balance_settlements")
}

model PayoutRecipient {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @unique @map("organization_id") @db.Uuid
  provider             String
  externalRecipientId  String?  @map("external_recipient_id")
  status               String   @default("PENDING_VERIFICATION")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  payouts      Payout[]

  @@index([organizationId])
  @@map("payout_recipients")
}

model Payout {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  recipientId       String    @map("recipient_id") @db.Uuid
  amount            BigInt
  currency          String
  status            String    @default("SCHEDULED")
  provider          String
  externalPayoutId  String?   @map("external_payout_id")
  idempotencyKey    String    @unique @map("idempotency_key")
  failureReason     String?   @map("failure_reason")
  requestedAt       DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  succeededAt       DateTime? @map("succeeded_at") @db.Timestamptz
  failedAt          DateTime? @map("failed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization         @relation(fields: [organizationId], references: [id])
  recipient          PayoutRecipient      @relation(fields: [recipientId], references: [id])
  webhookEvents      PayoutWebhookEvent[]

  @@index([organizationId], map: "payouts_org")
  @@index([status, requestedAt(sort: Desc)], map: "payouts_status")
  @@map("payouts")
}

model PayoutWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  providerEventId String    @map("provider_event_id")
  payoutId        String?   @map("payout_id") @db.Uuid
  rawPayload      Json      @map("raw_payload")
  processedAt     DateTime  @default(now()) @map("processed_at") @db.Timestamptz

  payout Payout? @relation(fields: [payoutId], references: [id])

  @@unique([provider, providerEventId])
  @@index([payoutId], map: "payout_webhook_events_payout")
  @@map("payout_webhook_events")
}

model PasswordCredential {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  hash          String
  algorithm     String   @default("argon2id") @map("algorithm") @db.VarChar(32)
  forceReset    Boolean  @default(false) @map("force_reset")
  lastChangedAt DateTime @default(now()) @map("last_changed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuthenticationAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @db.VarChar(320)
  ip          String
  outcome     String   @db.VarChar(16)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([email, ip, attemptedAt(sort: Desc)])
  @@index([ip, attemptedAt(sort: Desc)])
  @@map("authentication_attempts")
}

model MediaUpload {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  uploaderId     String    @map("uploader_id") @db.Uuid
  objectKey      String    @unique @map("object_key")
  contentType    String    @map("content_type") @db.VarChar(128)
  sizeBytes      BigInt?   @map("size_bytes")
  purpose        String    @db.VarChar(64)
  entityId       String    @map("entity_id") @db.Uuid
  status         String    @default("PENDING") @db.VarChar(16)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  uploader     User         @relation("UploadedMedia", fields: [uploaderId], references: [id])

  @@index([organizationId, entityId])
  @@map("media_uploads")
}

