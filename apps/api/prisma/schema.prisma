generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  displayName String?   @map("display_name")
  locale      String    @default("pt-BR")
  timezone    String    @default("America/Sao_Paulo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  identities          Identity[]
  ownedOrganizations  Organization[]       @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]

  @@index([deletedAt])
  @@map("users")
}

model Identity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String
  providerUserId String   @map("provider_user_id")
  email          String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String    @unique
  name      String
  status    String    @default("ACTIVE")
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  owner            User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members          OrganizationMember[]
  events           Event[]
  venues           Venue[]
  ticketTypes      TicketType[]
  ticketInventories TicketInventory[]
  reservations     Reservation[]
  orders           Order[]
  paymentAttempts  PaymentAttempt[]
  tickets          Ticket[]
  ticketCredentials TicketCredential[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    @default("MEMBER")
  status         String    @default("INVITED")
  invitedAt      DateTime  @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt       DateTime? @map("joined_at") @db.Timestamptz
  removedAt      DateTime? @map("removed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model IdempotencyRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  type           String
  version        String    @default("1")
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  processedAt    DateTime? @map("processed_at") @db.Timestamptz
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([processedAt])
  @@index([organizationId])
  @@map("outbox_events")
}

model Venue {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(500)
  address        String
  city           String       @db.VarChar(255)
  state          String       @db.VarChar(255)
  country        String       @db.VarChar(2)
  postalCode     String?      @map("postal_code") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id])
  events         Event[]

  @@index([organizationId])
  @@map("venues")
}

model Event {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String       @db.VarChar(500)
  description    String?
  status         String       @default("DRAFT") @db.VarChar(50)
  version        Int          @default(1)
  slug           String?      @db.VarChar(500)
  metadata       Json?
  format         String?      @db.VarChar(50)
  startsAt       DateTime?    @map("starts_at") @db.Timestamptz
  endsAt         DateTime?    @map("ends_at") @db.Timestamptz
  timezone       String?      @db.VarChar(100)
  onlineInfo     String?      @map("online_info")
  venueId        String?      @map("venue_id") @db.Uuid
  currency       String?      @db.VarChar(3)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization      @relation(fields: [organizationId], references: [id])
  venue             Venue?            @relation(fields: [venueId], references: [id])
  ticketTypes       TicketType[]
  ticketInventories TicketInventory[]
  reservations      Reservation[]
  orders            Order[]
  tickets           Ticket[]

  @@index([organizationId])
  @@index([status])
  @@index([venueId])
  @@unique([slug])
  @@map("events")
}

model TicketType {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  name           String            @db.VarChar(500)
  description    String?
  priceAmount    Int               @map("price_amount")
  capacity       Int
  status         String            @default("ACTIVE") @db.VarChar(50)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  event           Event             @relation(fields: [eventId], references: [id])
  organization    Organization      @relation(fields: [organizationId], references: [id])
  ticketInventory TicketInventory?
  reservationItems ReservationItem[]
  orderItems       OrderItem[]
  tickets          Ticket[]

  @@index([eventId])
  @@index([organizationId])
  @@index([status])
  @@map("ticket_types")
}

model AuditEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([organizationId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("audit_entries")
}

model TicketInventory {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketTypeId   String     @unique @map("ticket_type_id") @db.Uuid
  eventId        String     @map("event_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  capacity       Int
  reserved       Int        @default(0)
  committed      Int        @default(0)
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([eventId])
  @@index([organizationId])
  @@map("ticket_inventory")
}

model Reservation {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  eventId               String            @map("event_id") @db.Uuid
  status                String            @default("ACTIVE") @db.VarChar(20)
  continuationTokenHash String            @map("continuation_token_hash") @db.VarChar(64)
  idempotencyKey        String?           @unique @map("idempotency_key") @db.VarChar(255)
  expiresAt             DateTime          @map("expires_at") @db.Timestamptz
  currency              String            @db.VarChar(3)
  subtotalAmount        BigInt            @default(0) @map("subtotal_amount")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id])
  event        Event              @relation(fields: [eventId], references: [id])
  items        ReservationItem[]
  order        Order?

  @@index([organizationId, eventId])
  @@index([expiresAt])
  @@index([status])
  @@map("reservations")
}

model ReservationItem {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId   String      @map("reservation_id") @db.Uuid
  ticketTypeId    String      @map("ticket_type_id") @db.Uuid
  quantity        Int
  nameSnapshot    String      @map("name_snapshot") @db.VarChar(500)
  unitPriceAmount BigInt      @map("unit_price_amount")
  currency        String      @db.VarChar(3)
  subtotalAmount  BigInt      @map("subtotal_amount")

  reservation Reservation @relation(fields: [reservationId], references: [id])
  ticketType  TicketType  @relation(fields: [ticketTypeId], references: [id])

  @@index([reservationId])
  @@index([ticketTypeId])
  @@map("reservation_items")
}

model Order {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  reservationId  String      @unique @map("reservation_id") @db.Uuid
  status         String      @default("PENDING_PAYMENT") @db.VarChar(30)
  currency       String      @db.VarChar(3)
  subtotalAmount BigInt      @map("subtotal_amount")
  totalAmount    BigInt      @map("total_amount")
  idempotencyKey String?     @unique @map("idempotency_key") @db.VarChar(255)
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  reservation  Reservation  @relation(fields: [reservationId], references: [id])
  items        OrderItem[]
  paymentAttempts PaymentAttempt[]
  tickets      Ticket[]

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("orders")
}

model OrderItem {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String     @map("order_id") @db.Uuid
  ticketTypeId    String     @map("ticket_type_id") @db.Uuid
  nameSnapshot    String     @map("name_snapshot") @db.VarChar(500)
  unitPriceAmount BigInt     @map("unit_price_amount")
  quantity        Int
  subtotalAmount  BigInt     @map("subtotal_amount")

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@map("order_items")
}

model PaymentAttempt {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  provider           String    @db.VarChar(50)
  externalPaymentId  String?   @unique @map("external_payment_id") @db.VarChar(255)
  status             String    @default("PENDING") @db.VarChar(20)
  paymentMethod      String    @map("payment_method") @db.VarChar(50)
  amount             BigInt
  currency           String    @db.VarChar(3)
  idempotencyKey     String?   @unique @map("idempotency_key") @db.VarChar(255)
  failureCode        String?   @map("failure_code") @db.VarChar(100)
  checkoutData       Json?     @map("checkout_data")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization          @relation(fields: [organizationId], references: [id])
  order         Order                 @relation(fields: [orderId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([orderId])
  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String    @db.VarChar(50)
  providerEventId   String    @map("provider_event_id") @db.VarChar(255)
  paymentAttemptId  String?   @map("payment_attempt_id") @db.Uuid
  externalPaymentId String    @map("external_payment_id") @db.VarChar(255)
  eventType         String    @map("event_type") @db.VarChar(100)
  rawStatus         String    @map("raw_status") @db.VarChar(100)
  amount            BigInt?
  currency          String?   @db.VarChar(3)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz
  failedAt          DateTime? @map("failed_at") @db.Timestamptz
  errorMessage      String?   @map("error_message")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@unique([provider, providerEventId])
  @@index([externalPaymentId])
  @@index([paymentAttemptId])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model Ticket {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  orderItemId    String   @map("order_item_id") @db.Uuid
  ticketTypeId   String   @map("ticket_type_id") @db.Uuid
  unitIndex      Int      @map("unit_index")
  publicCode     String   @unique @map("public_code") @db.VarChar(64)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  event        Event        @relation(fields: [eventId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id])
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  credentials  TicketCredential[]

  @@unique([orderItemId, unitIndex])
  @@index([orderId])
  @@index([organizationId])
  @@index([eventId])
  @@index([ticketTypeId])
  @@map("tickets")
}

model TicketCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  status         String    @default("ACTIVE") @db.VarChar(20)
  version        Int       @default(1)
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  ticket       Ticket       @relation(fields: [ticketId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([ticketId])
  @@index([organizationId])
  @@map("ticket_credentials")
}
