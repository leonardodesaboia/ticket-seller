# API — Local Development Environment Variables
# Copy this file to .env and adjust values as needed.
# NEVER commit the actual .env file.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated origins. Use * for development only.
# In production, set this to your actual frontend origin(s).
CORS_ORIGINS=*

# Payment provider. Only "fake" is supported in the MVP.
PAYMENT_PROVIDER=fake
# Required when NODE_ENV=production and PAYMENT_PROVIDER=fake.
FAKE_GATEWAY_SECRET=

# Required when NODE_ENV=production. Use a long, unique secret in production.
FAKE_PAYOUT_SECRET=

# Redis connection. Must include the password set in compose.yaml (REDIS_PASSWORD).
# Format: redis://:<password>@<host>:<port>
REDIS_URL=redis://:redis-dev-password@localhost:6379

# PostgreSQL connection URL.
# connection_limit caps Prisma's connection pool. Default is cpu_count * 2 + 1.
# In production, set this to (DB_max_connections - pg-boss connections - headroom) / replica_count.
# Example for a single-replica setup with max_connections=100 and pg-boss using 10:
#   connection_limit=20 leaves 70 connections for other clients and headroom.
# Format: postgresql://user:pass@host:port/db?connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticket_seller
