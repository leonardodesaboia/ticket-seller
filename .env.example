# Local Development Environment Variables
# ATTENTION: These are DEFAULT values for local development only.
# Do NOT use these credentials in production environments.
# Copy this file to .env and adjust values as needed.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticket_seller
# Change PORT_POSTGRES to avoid conflict with a local PostgreSQL instance
PORT_POSTGRES=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Change PORT_REDIS to avoid conflict with a local Redis instance
PORT_REDIS=6379

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# API endpoint (used by applications)
PORT_MINIO_API=9000
# Web console (browser access)
PORT_MINIO_CONSOLE=9001

# -----------------------------------------------------------------------------
# Mailpit (local SMTP server with web UI for development)
# -----------------------------------------------------------------------------
# SMTP port — configure your application to send emails to localhost:1025
PORT_MAILPIT_SMTP=1025
# Web UI to inspect sent emails: http://localhost:8025
PORT_MAILPIT_UI=8025
